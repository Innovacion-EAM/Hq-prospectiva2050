# Base de datos: dumps creados por `make backup`
backups/

# Archivos subidos a la biblioteca. Son datos del servidor, no código, y además
# se cuelan en el árbol de trabajo cada vez que `make smoke` prueba la galería.
# La carpeta la crea el backend al arrancar, así que no hace falta versionarla.
backend/uploads/

# Claves privadas y certificados: nunca en git
*.pem
*.key

# Fuente original del repositorio: el Excel y los JSON de respaldo del proceso
# de limpieza de datos se mantienen fuera del repo (los datos públicos se sirven
# desde la semilla repositorio-seed.ts y desde la importación del backoffice).
repositorio/