PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:1234
DB_SYNCHRONIZE=true
# Contenido de muestra. Opt-in: solo se siembra con `true`. Ver la nota de
# backend/.env.docker.example. Este archivo es el que lee un backend levantado a
# mano (`make dev`), y por eso necesita la variable explícita: si la dejara
# fuera, ese backend rellenaría las tablas vacías de la base de desarrollo sin
# avisar, y las noticias de muestra volverían a aparecer solas.
SEED_CONTENIDO=false
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
UPLOAD_DIR=uploads

# Límites de peticiones (TTL en segundos). En local casi nunca se llega a
# tocar, pero se declaran para que el arranque sea igual que en producción.
# ⚠ THROTTLE_LIMIT_LOGIN y THROTTLE_LIMIT_FORMS son solo el SUELO del módulo:
# el guard de la librería los aplica a TODAS las rutas, así que bajarlos (p. ej.
# 5 y 3) limitaría también al sitio público y devolvería 429 tras unos pocos
# accesos. Los límites reales (login 5/15min por cuenta, forms 3/hora por IP)
# los ponen los decoradores @Throttle, no estas variables. Ver auth/throttler.ts.
THROTTLE_TTL_DEFAULT=60
THROTTLE_LIMIT_DEFAULT=120
THROTTLE_TTL_LOGIN=900
THROTTLE_LIMIT_LOGIN=10000
THROTTLE_TTL_FORMS=3600
THROTTLE_LIMIT_FORMS=10000