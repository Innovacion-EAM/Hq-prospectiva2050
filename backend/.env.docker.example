PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost
# VARIANTE HOST-BASED (descomentar para usar): CORS_ORIGINS=http://localhost,http://backoffice.localhost
DB_SYNCHRONIZE=true
# Contenido de muestra. El interruptor es opt-in: hay que poner `true` para que
# se siembre, así que un entorno recién clonado arranca **vacío**, que es lo que
# hace falta para probar el sitio con lo que se escriba a mano.
# `true` = siembra noticias, documentos, municipios, dimensiones y mensajes de
# muestra. Las cuentas y la configuración del sitio se siembran igual en los dos
# casos: sin ellas no hay backoffice donde escribir ni sitio que arranque.
# `make db-reset` pone esto a `true`; `make db-vacia` lo devuelve a `false`.
SEED_CONTENIDO=false
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
UPLOAD_DIR=uploads
