POSTGRES_USER=hq_app
POSTGRES_PASSWORD=<CAMBIAR_ESTE_PASSWORD>
POSTGRES_DB=hq_prospectiva2050

# ── Dominio público del sitio ─────────────────────────────────────────────────
# Lo usan los routers de Traefik Y debe coincidir con CORS_ORIGINS y con
# VITE_API_URL de backend/.env.prod, frontend/.env.prod y backoffice/.env.prod.
HQ_SITE_HOST=prospectivaquindio2050.com

# ── Imágenes del registro (opcional) ─────────────────────────────────────────
# Solo si necesitas fijar/rollbackear una versión concreta. Sin esto, el overlay
# usa ghcr.io/innovacion-eam/hq-{backend,frontend,backoffice}:latest.
# HQ_BACKEND_IMAGE=ghcr.io/innovacion-eam/hq-backend:v1.0.0
# HQ_FRONTEND_IMAGE=ghcr.io/innovacion-eam/hq-frontend:v1.0.0
# HQ_BACKOFFICE_IMAGE=ghcr.io/innovacion-eam/hq-backoffice:v1.0.0
