PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost
# VARIANTE HOST-BASED (descomentar para usar): CORS_ORIGINS=http://localhost,http://backoffice.localhost
DB_SYNCHRONIZE=true
# Contenido de muestra. El interruptor es opt-in: hay que poner `true` para que
# se siembre, así que un entorno recién clonado arranca **vacío**, que es lo que
# hace falta para probar el sitio con lo que se escriba a mano.
# `true` = siembra noticias, documentos, municipios, dimensiones y mensajes de
# muestra. Las cuentas y la configuración del sitio se siembran igual en los dos
# casos: sin ellas no hay backoffice donde escribir ni sitio que arranque.
# `make db-reset` pone esto a `true`; `make db-vacia` lo devuelve a `false`.
SEED_CONTENIDO=false
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
UPLOAD_DIR=uploads

# Límites de peticiones (TTL en segundos). En local casi nunca se llega a
# tocar, pero se declaran para que el arranque sea igual que en producción.
# ⚠ THROTTLE_LIMIT_LOGIN y THROTTLE_LIMIT_FORMS son solo el suelo: se aplican a
# todas las rutas, así que bajar esos valores limitaría también al sitio
# público. Los límites reales (login 5/15min por cuenta, forms 3/hora por IP)
# los ponen los decoradores @Throttle. Ver auth/throttler.ts.
#
# El stack LOCAL sirve con el throttling apagado (THROTTLE_ENABLED=false), como
# la fase `test:e2e:api`: `make smoke` y quien navegue a mano hacen decenas de
# peticiones de formularios desde la misma IP, y el límite real de 3/hora los
# cortaría con 429. Los límites de verdad NO se comprueban aquí: los verifica
# `test:e2e:core` (throttle.e2e-spec.ts) con todo activo. Producción NO define
# THROTTLE_ENABLED, así que en el servidor los 3/hora de los formularios sí
# protegen la bandeja.
THROTTLE_ENABLED=false
THROTTLE_TTL_DEFAULT=60
THROTTLE_LIMIT_DEFAULT=120
THROTTLE_TTL_LOGIN=900
THROTTLE_LIMIT_LOGIN=10000
THROTTLE_TTL_FORMS=3600
THROTTLE_LIMIT_FORMS=10000
