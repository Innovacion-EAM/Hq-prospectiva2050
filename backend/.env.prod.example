PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=hq_app
DB_PASSWORD=<CAMBIAR_ESTE_PASSWORD>
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=https://prospectivaquindio2050.com

# Nunca sincronizar el esquema en producción: se versiona con migraciones.
# En docker el compose base monta el volumen en /app/uploads, así que
# UPLOAD_DIR tiene que coincidir con ese punto de montaje.
DB_SYNCHRONIZE=false
UPLOAD_DIR=/app/uploads

JWT_SECRET=<CAMBIAR_ESTE_SECRET>
