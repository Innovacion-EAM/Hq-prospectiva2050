# Entorno para los tests e2E del backend (`make test-e2e`).
# Apunta a la base de datos que publica el compose en 127.0.0.1:5432.
# El esquema y el usuario admin los crea el backend al arrancar (synchronize).
PORT=3006
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost:5173,http://localhost:1234
DB_SYNCHRONIZE=true

JWT_SECRET=e2e-only-no-usar-en-produccion-0000000000000000000000000000
UPLOAD_DIR=uploads
