PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=hq_app
DB_PASSWORD=<CAMBIAR_ESTE_PASSWORD>
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=https://prospectivaquindio2050.com
DB_SYNCHRONIZE=false

UPLOAD_DIR=uploads
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
JWT_EXPIRES_IN=12h

# Límites de peticiones (TTL en segundos). Los tres contadores tienen que estar
# declarados: el guard solo recorre los que aparecen en el módulo
# `auth/throttler.ts`, y uno que no exista ahí no se aplica aunque su ruta
# lleve el decorador @Throttle.
#
#   default: techo general de la API. Alto a propósito; frena volumetrías, no
#            a un usuario real.
#   login:   el decorador de auth.controller.ts pone 5 por 15 min y por cuenta
#            (correo + IP), que son los valores buenos. Aquí solo está el
#            suelo de arranque.
#   forms:   ídem: el decorador de forms.controller.ts pone 3 por hora y por IP.
#
# ⚠ NO bajar THROTTLE_LIMIT_LOGIN ni THROTTLE_LIMIT_FORMS: estos dos contadores
# se aplican a TODAS las rutas (así funciona el guard), no solo a las del
# decorador. Un suelo pequeño limita también al sitio público y cualquier
# endpoint devuelve 429 después de 3-5 peticiones por hora desde la misma IP.
# 10000 es deliberadamente alto: lo dejan sin efecto global y los límites de
# verdad viven en los decoradores.
THROTTLE_TTL_DEFAULT=60
THROTTLE_LIMIT_DEFAULT=120
THROTTLE_TTL_LOGIN=900
THROTTLE_LIMIT_LOGIN=10000
THROTTLE_TTL_FORMS=3600
THROTTLE_LIMIT_FORMS=10000
