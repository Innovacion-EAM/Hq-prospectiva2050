PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost
# VARIANTE HOST-BASED (descomentar para usar): CORS_ORIGINS=http://localhost,http://backoffice.localhost
DB_SYNCHRONIZE=true
# `false` = la base arranca sin contenido de muestra (noticias, documentos,
# municipios, dimensiones, mensajes). Las cuentas y la configuración del sitio
# se siembran igual: sin ellas no hay backoffice donde escribir.
# `make db-vacia` pone esto a `false`; `make db-reset` lo devuelve a `true`.
SEED_CONTENIDO=true
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
UPLOAD_DIR=uploads
