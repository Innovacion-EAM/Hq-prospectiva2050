# Entorno para los tests e2E del backend (`make test-e2e`).
# Apunta a la base de datos que publica el compose en 127.0.0.1:5432.
# El esquema y el usuario admin los crea el backend al arrancar (synchronize).
PORT=3006
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=http://localhost:5173,http://localhost:1234
DB_SYNCHRONIZE=true
# `false` = la app que monta la suite no siembra contenido. Apunta a la MISMA base
# que usa el backoffice, así que con la semilla puesta los tests llenaban la base
# de desarrollo cada vez que se corrían.
# `make test-e2e` lo pasa también por el entorno, que es lo que manda.
SEED_CONTENIDO=false

JWT_SECRET=e2e-only-no-usar-en-produccion-0000000000000000000000000000
UPLOAD_DIR=uploads
