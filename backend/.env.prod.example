PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=hq_app
DB_PASSWORD=<CAMBIAR_ESTE_PASSWORD>
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=https://prospectivaquindio2050.com
DB_SYNCHRONIZE=false

UPLOAD_DIR=uploads
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
JWT_EXPIRES_IN=12h

# Límites de peticiones (TTL en segundos). Los tres contadores tienen que estar
# declarados: el guard solo recorre los que aparecen en el módulo
# `auth/throttler.ts`, y uno que no exista ahí no se aplica aunque su ruta
# lleve el decorador @Throttle.
#
#   default: techo general de la API. Alto a propósito; frena volumetrías, no
#            a un usuario real.
#   login:   el decorador de auth.controller.ts pone 5 por 15 min, que es el
#            valor bueno. Aquí solo están los de arranque.
#   forms:   ídem: el decorador de forms.controller.ts pone 3 por hora.
#
# Si se cambian THROTTLE_LIMIT_LOGIN o THROTTLE_LIMIT_FORMS y parece que no
# hacen nada, es por eso: en un decorador siempre gana el decorador.
THROTTLE_TTL_DEFAULT=60
THROTTLE_LIMIT_DEFAULT=120
THROTTLE_TTL_LOGIN=900
THROTTLE_LIMIT_LOGIN=5
THROTTLE_TTL_FORMS=3600
THROTTLE_LIMIT_FORMS=3
