PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=hq_app
DB_PASSWORD=<CAMBIAR_ESTE_PASSWORD>
DB_NAME=hq_prospectiva2050
CORS_ORIGINS=https://prospectivaquindio2050.com
DB_SYNCHRONIZE=false

UPLOAD_DIR=uploads
JWT_SECRET=<CAMBIAR_ESTE_SECRET>
JWT_EXPIRES_IN=12h

# Límites de peticiones (TTL en segundos). Solo el techo general de la API.
# Alto a propósito: frena ataques volumétricos, no a un usuario real.
# Los límites del login (5 por cada 15 min, por correo+IP) y de los formularios
# (3 por hora, por IP) están en los decoradores @Throttle de sus controladores.
THROTTLE_TTL_DEFAULT=60
THROTTLE_LIMIT_DEFAULT=120
